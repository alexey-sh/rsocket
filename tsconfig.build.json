{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "declaration": true,
    // Each package's `typecheck` script runs tsc over this config, and the
    // build bundles with rolldown (via tsdown) — which resolves exports across
    // module boundaries and rejects a type re-exported as a value. Keep tsc the
    // first thing to complain about that.
    "isolatedModules": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "exclude": ["node_modules", "dist", "**/__tests__"]
}
