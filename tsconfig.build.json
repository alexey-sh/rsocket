{
  "compilerOptions": {
    // tsup's .d.ts rollup unconditionally injects `baseUrl: "."`, which TS 6
    // deprecates (TS5101). We don't use baseUrl ourselves; this silences that
    // one injected option until TS 7 / a tsup fix drops it.
    "ignoreDeprecations": "6.0",
    "module": "commonjs",
    "target": "ES2022",
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "declaration": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__"
  ]
}
