{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "sourceMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
    "declaration": true,
    "resolveJsonModule": true,
    // Enabling `strict` incrementally. These are on; noImplicitAny +
    // strictNullChecks land together next (they interact: without
    // strictNullChecks, null/undefined widen to `any` and trip noImplicitAny),
    // then strictPropertyInitialization, before this scaffold becomes
    // strict:true.
    "strict": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "useUnknownInCatchVariables": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/__tests__"
  ]
}
