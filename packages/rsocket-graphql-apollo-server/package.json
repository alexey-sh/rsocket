{
  "name": "@rsocket-ts/graphql-apollo-server",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn run clean && yarn run typecheck && yarn run compile",
    "clean": "rimraf ./dist",
    "compile": "tsdown",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "yarn run build",
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@graphql-tools/schema": "^10.0.36",
    "@rsocket-ts/composite-metadata": "^2.0.0",
    "@rsocket-ts/core": "^2.0.0",
    "graphql": "^16.11.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3"
  }
}
