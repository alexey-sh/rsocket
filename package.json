{
  "name": "@rsocket-ts/monorepo",
  "description": "The @rsocket-ts monorepo root (private; individual packages publish under @rsocket-ts/*).",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "lerna run build",
    "clean": "lerna run clean && rimraf ./coverage",
    "pub": "bash scripts/publish.sh",
    "pretest": "yarn clean",
    "test": "lerna run test",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "check:exports": "yarn build && for p in core composite-metadata messaging adapter-rxjs tcp-client tcp-server websocket-client websocket-server graphql-apollo-link graphql-apollo-server; do attw --pack \"packages/rsocket-$p\" || exit 1; done"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/sinon": "^22.0.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.4",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-config": "^30.4.2",
    "jest-mock-extended": "^4.0.1",
    "lerna": "^9.0.7",
    "prettier": "^3.9.4",
    "sinon": "^22.0.0",
    "ts-jest": "^29.4.11",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  }
}
